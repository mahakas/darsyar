# Darsyar v4 — template only. Never commit .env or real secrets.
APP_ENV=development
APP_NAME=Darsyar AI
APP_VERSION=0.1.0
APP_SECRET_KEY=CHANGE_ME_generate_at_least_32_random_bytes
APP_CORS_ORIGINS=["http://localhost:5173"]
TRUSTED_HOSTS=["localhost","127.0.0.1","api"]
FORWARDED_ALLOW_IPS=127.0.0.1
REQUEST_ID_HEADER=X-Request-ID
REFRESH_COOKIE_NAME=darsyar_refresh
CSRF_COOKIE_NAME=darsyar_csrf
LOG_LEVEL=INFO

POSTGRES_USER=darsyar
POSTGRES_PASSWORD=CHANGE_ME_url_safe_local_only_password
POSTGRES_DB=darsyar
DATABASE_URL=postgresql+asyncpg://darsyar:CHANGE_ME_url_safe_local_only_password@localhost:5432/darsyar
TEST_DATABASE_URL=postgresql+asyncpg://darsyar:CHANGE_ME_url_safe_local_only_password@localhost:5432/darsyar_test
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
SETTINGS_CACHE_TTL=30
SINGLE_FLIGHT_TTL=10

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_GRACE_SECONDS=30
JWT_PREVIOUS_SECRET=
OTP_PEPPER=CHANGE_ME_independent_random_pepper
OTP_PEPPER_ID=v1
OTP_PREVIOUS_PEPPER=
OTP_CODE_LENGTH=6
OTP_EXPIRE_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT_PHONE=3
OTP_REQUEST_WINDOW=300
OTP_REQUEST_LIMIT_IP=10
OTP_VERIFY_RATE_IP=20
CHAT_RATE_USER=30
CHAT_RATE_IP=60

LLM_PROVIDER=nvidia
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODELS=[]
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=2
MAX_CONTEXT_TOKENS=12000

INFERENCE_MODE=remote
INFERENCE_URL=http://inference:8100
INFERENCE_TIMEOUT_SECONDS=10
REQUEST_TIMEOUT_SECONDS=60
MODEL_TIMEOUT_SECONDS=60
INFERENCE_DEVICE=cpu
EMBEDDING_BACKEND=remote
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_REMOTE_BASE_URL=
EMBEDDING_REMOTE_API_KEY=
EMBEDDING_REMOTE_MODEL=
RERANK_BACKEND=remote
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=20
RERANKER_MIN_SCORE=0.35
RERANKER_CACHE_TTL=3600

RETRIEVAL_TOP_K_DENSE=50
RETRIEVAL_TOP_K_LEXICAL=50
RETRIEVAL_TOP_K_FINAL=20
RRF_K=60
MIN_CONFIDENCE=0.35
MIN_RETRIEVAL_SCORE=0.0
REWRITE_MAX_ATTEMPTS=2
RETRIEVAL_TIMEOUT_MS=3000
TRGM_SIMILARITY_THRESHOLD=0.25
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=40

RESOURCES_DIR=./resources
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
MAX_USER_UPLOAD_MB=20
ALLOWED_FORMATS=["pdf","docx","txt","html","png","jpg","jpeg"]
USER_UPLOAD_RETENTION_DAYS=7
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=60
PARENT_CHUNK_SIZE=1200
OCR_LANGUAGES=fas+eng
VLM_ENABLED=false
VLM_BASE_URL=
VLM_MODEL=
ACTIVE_EDITION_YEAR=1403
INGEST_BATCH_SIZE=16

WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=10
ALLOWED_FETCH_DOMAINS=[]

# تعداد اعتبار رایگان برای کاربر تازه‌ثبت‌نام‌شده (یک‌بار؛ R-135/ADR-048)
FREE_PLAN_CREDITS=5
PLAN_BASIC_PRICE_TOMAN=500000
PLAN_BASIC_CREDITS=500
PLAN_PRO_PRICE_TOMAN=1000000
PLAN_PRO_CREDITS=1200
PLAN_UNLIMITED_MIN_TOMAN=1500000
PLAN_UNLIMITED_FAIR_USE=10000
PLAN_PERIOD_TIMEZONE=Asia/Tehran
RESERVATION_STALE_MINUTES=15
RECONCILE_INTERVAL_MINUTES=5
MIN_BILLABLE_TOKENS=1
# واحد: تعداد اعتبار (credit)؛ هشدار فقط وقتی |available_balance - sum_balance_affecting| > این مقدار
CREDIT_RECONCILE_ALERT_THRESHOLD=1

PAYMENT_PROVIDER=zarinpal
ZARINPAL_MERCHANT_ID=CHANGE_ME_valid_uuid_merchant_id
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:8000/api/v1/billing/callback
ZARINPAL_TIMEOUT_SECONDS=10
PAYMENT_REQUEST_STALE_MINUTES=30
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
KAVENEGAR_TIMEOUT_SECONDS=10

PAGE_SIZE_MAX=100
MAX_REQUEST_BYTES=20971520
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_NAME=
ADMIN_PASSWORD_LOGIN_ENABLED=false

DEFAULT_LANGUAGE=fa
SUPPORTED_LANGUAGES=["fa","en","ar"]
LOG_FORMAT=json
TRACE_STORE_PROMPTS=false
SENTRY_DSN=
VITE_API_BASE_URL=/api/v1
VITE_SSE_TIMEOUT_MS=60000

# Compose-only development values; pin image digests in production.
POSTGRES_IMAGE_TAG=pgvector/pgvector:0.8.7-pg18-bookworm
REDIS_IMAGE_TAG=redis:7.4.12-bookworm
# Production digest for redis:7.4.12-bookworm (ADR-044, owner-approved):
# sha256:bd28fff4b665fdf1b73e8b5b73ec05d2f858f4fa3c8ea0d7c9bc09f7f6bf7039
BACKEND_IMAGE_TAG=local
WORKER_CONCURRENCY=4
WORKER_MEMORY_LIMIT=1g
HF_CACHE_DIR=/models/huggingface
HF_HOME=/models/huggingface
REDIS_MAXMEMORY=512mb
