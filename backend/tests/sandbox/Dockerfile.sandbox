# Standalone Linux OS-level sandbox prototype image (Gate B-S2).
# This image is experimental and used ONLY by the sandbox test harness. It is
# NOT part of the application deployment (docker-compose.yml / backend/Dockerfile
# are untouched). The OS-level fences are applied at `docker run` time
# (--network none, --read-only, --memory, --cpus, --pids-limit, --cap-drop ALL,
# --security-opt no-new-privileges, non-root user).
#
# Pins the exact lockfile parser version: pypdf==6.21.3.

FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/tmp \
    DARSYAR_SANDBOX_PROBE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends procps \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --upgrade pip \
    && pip install \
        "pypdf==6.21.3" \
        "pytest>=8,<9" \
        "pytest-asyncio>=1.2,<2"

WORKDIR /app
COPY app /app/app
COPY tests /app/tests

USER 65534:65534

CMD ["python", "-m", "pytest", \
     "tests/test_gate_b_linux_sandbox.py", \
     "tests/test_gate_b_parent_child.py", \
     "tests/test_gate_b_pdf_validation.py", \
     "-q", "-p", "no:cacheprovider"]
